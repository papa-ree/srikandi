     * purpose sama di dua client itu sah, tapi yang satu tidak akan pernah
     * dipakai `OtpService` - jadi route yatim lebih bersih dihapus.
     */
    protected function moveRoute(object $target): void
    {
        $legacy = DB::table('wara_clients')->where('name', self::LEGACY_CLIENT)->first();

        if ($legacy === null) {
            return;
        }

        $route = DB::table('wara_routes')
            ->where('client_id', $legacy->id)
            ->where('purpose', self::MIGRATED_PURPOSE)
            ->first();

        if ($route === null) {
            return;
        }

        $alreadyOwned = DB::table('wara_routes')
            ->where('client_id', $target->id)
            ->where('purpose', self::MIGRATED_PURPOSE)
            ->exists();

        if ($alreadyOwned) {
            DB::table('wara_routes')->where('id', $route->id)->delete();

            $this->line('  Route "'.self::MIGRATED_PURPOSE.'" sudah ada di client Srikandi; yang bawaan dihapus.');

            return;
        }

        DB::table('wara_routes')->where('id', $route->id)->update(['client_id' => $target->id]);

        $this->line('  Route "'.$route->purpose.'" -> "'.$route->device_id.'" dipindah ke '.self::SRIKANDI_CLIENT);
    }

    /**
     * Hapus route yang sudah tidak punya pemilik, lalu client bawaannya.
     *
     * 🔴 Route `notifikasi` dihapus, bukan dipindah. Package `Nawasara\Wago`
     * sudah di-uninstall, jadi tidak ada lagi yang memakainya. Device
     * `wago prod` sendiri tetap ada di `wara_sessions` - itu milik GOWA.
     *
     * 🔴 APABILA ada route lain yang tidak dikenal, migrasi BERHENTI.
     *
     * Menebak jalan untuk route yang tidak dikenal berarti menghapus keputusan
     * admin tanpa persetujuan. Route yang tidak kita kenali harus diputuskan
     * manusia - dan pesannya menyebut purpose-nya supaya bisa langsung
     * ditindaklanjuti.
     */
    protected function dropLegacyClient(): void
    {
        $legacy = DB::table('wara_clients')->where('name', self::LEGACY_CLIENT)->first();

        if ($legacy === null) {
            return;
        }

        $orphans = DB::table('wara_routes')->where('client_id', $legacy->id)->get();

        $movable = $orphans->where('purpose', self::ORPHANED_PURPOSE);

        foreach ($movable as $route) {
            DB::table('wara_routes')->where('id', $route->id)->delete();

            $this->line(sprintf(
                '  - Route "%s" -> "%s" dihapus (package pemiliknya sudah uninstalled)',
                $route->purpose,
                $route->device_id
            ));
        }

        $remaining = DB::table('wara_routes')->where('client_id', $legacy->id)->get();

        if ($remaining->isNotEmpty()) {
            $purposes = $remaining->pluck('purpose')->implode(', ');

            throw new RuntimeException(sprintf(
                'Client "%s" masih memegang route yang tidak dikenal: %s. Route '
                .'ini bukan milik bale/srikandi dan tidak ikut dihapus. Petakan ke '
                .'client yang tepat di `Wara > Client`, atau hapus manual sebelum '
                .'menjalankan ulang migrasi ini.',
                self::LEGACY_CLIENT,
                $purposes
            ));
        }

        DB::table('wara_clients')->where('id', $legacy->id)->delete();

        $this->line('  - Client Wara: '.self::LEGACY_CLIENT);
    }

    /**
     * Laravel screaming pada output migrasi, bukan echo - supaya tidak ikut
     * tercetak di production tanpa disadari.
     */
    protected function line(string $message): void
    {
        if (method_exists($this, 'getIo') && $this->getIo() !== null) {
            $this->getIo()->writeln($message);
        }
    }
