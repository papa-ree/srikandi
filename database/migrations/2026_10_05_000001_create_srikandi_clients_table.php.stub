            DB::table('wara_routes')
                ->where('client_id', $target->id)
                ->where('purpose', self::MIGRATED_PURPOSE)
                ->update(['client_id' => $legacy->id]);

            DB::table('wara_clients')->where('id', $target->id)->delete();
