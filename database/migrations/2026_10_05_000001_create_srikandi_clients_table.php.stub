        $id = (string) Str::uuid();

        DB::table('wara_clients')->insert([
            'id' => $id,
            // `bale_id` NULL: client package internal, bukan organisasi penyewa.
            'bale_id' => null,
            'type' => 'service',
            'api_token_id' => null,
            'name' => self::SRIKANDI_CLIENT,
            'is_active' => true,
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        $this->line('  + Client Wara: '.self::SRIKANDI_CLIENT);

        return DB::table('wara_clients')->where('id', $id)->first();
    }

    /**
     * Pindahkan route `otp` dari client bawaan ke client Srikandi.
     *
     * 🔴 Kalau client Srikandi sudah punya route `otp` (mis. karena `down()`
