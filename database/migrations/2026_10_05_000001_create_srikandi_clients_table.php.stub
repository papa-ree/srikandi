    public function restoreWaraClient(): void
    {
        if (! Schema::hasTable('wara_clients')) {
            return;
        }

        DB::transaction(function () {
            $target = DB::table('wara_clients')->where('name', self::SRIKANDI_CLIENT)->first();

            if ($target === null) {
                return;
            }

            // Kembalikan route `otp` ke client bawaan.
            $legacy = DB::table('wara_clients')->where('name', self::LEGACY_CLIENT)->first();

            if ($legacy === null) {
                $this->line('  Lewati: client bawaan tidak ada, route tidak bisa dikembalikan.');

                return;
