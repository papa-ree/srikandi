# ==============================================================================
# bale/srikandi — .gitignore
#
# Repo ini berdiri sendiri; `.gitignore` direktori induk tidak berlaku di sini.
# Parent `bale-dev` meng-ignore `/packages`, jadi apa pun yang tidak ikut
# ter-commit parent HARUS ikut ter-commit repo ini. Kalau tidak, kode hilang
# tanpa jejak.
# ==============================================================================

# --- Dependency ---
# `packages/srikandi` tidak punya vendor sendiri - ia memakai vendor dari
# parent. Kalau nanti `composer install` dijalankan di dalam package, jangan ikut.
/vendor/

# --- Rahasia / konfigurasi lokal ---------------------------------------------
# 🔴 `otp_secret` dikembalikan polos oleh `POST /user/api/auth/get-update-data`.
# Kalau dump `.env` atau cache config pernah masuk ke sini, semua akun kena.
.env
.env.*
!.env.example

# --- Artefak test -----------------------------------------------------------
.phpunit.cache/
.phpunit.result.cache
testbench.yaml
workbench/

# --- OS / editor ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
*~